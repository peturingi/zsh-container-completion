(( $+functions[__container_registries] )) ||
__container_registries() { __container_names registries registry registry "$@" }

# --- argument formats ------------------------------------------------------

# `container:path` or a local path, as accepted by `container copy`.
(( $+functions[__container_copy_path] )) ||
__container_copy_path() {
  if compset -P '*:'; then
    _message -e paths 'path in container'
  else
    _alternative \
      'containers:container:__container_containers -qS:' \
      'files:local path:_files'
  fi
}

# --volume: `host-path:container-path` or `volume-name:container-path`.
(( $+functions[__container_volume_spec] )) ||
__container_volume_spec() {
  if compset -P '*:'; then
    _message -e paths 'path in container'
  else
    _alternative \
      'volumes:volume:__container_volumes -qS:' \
      'files:host path:_files'
  fi
}

# --publish-socket: `host-path:container-path`.
(( $+functions[__container_socket_spec] )) ||
__container_socket_spec() {
  if compset -P '*:'; then
    _message -e paths 'socket path in container'
  else
    _files
  fi
}

(( $+functions[__container_mount_spec] )) ||
__container_mount_spec() {
  _values -s , 'mount option' \
    'type[mount type]:type:(bind virtiofs tmpfs volume)' \
    '(src)source[host path or volume name]:source:_files' \
    '(source)src[host path or volume name]:source:_files' \
    '(dst target)destination[path in container]:path in container: ' \
    '(destination target)dst[path in container]:path in container: ' \
    '(destination dst)target[path in container]:path in container: ' \
    '(ro)readonly[mount read-only]' \
    '(readonly)ro[mount read-only]' \
    'size[tmpfs size]:size: ' \
    'mode[tmpfs mode]:mode: '
}

(( $+functions[__container_ulimit] )) ||
__container_ulimit() {
  local expl
  if compset -P '*='; then
    _message -e limits 'soft[:hard] limit'
  else
    _wanted ulimits expl 'resource limit' compadd -qS= \
      core cpu data fsize locks memlock msgqueue nice nofile nproc rss \
      rtprio rttime sigpending stack
  fi
}

(( $+functions[__container_machine_settings] )) ||
__container_machine_settings() {
  _values -w setting \
    'cpus[number of virtual CPUs]:number: ' \
    'memory[memory allocation (e.g. 2G)]:size: ' \
    'home-mount[home directory mount option]:mode:(ro rw none)' \
    'virtualization[enable nested virtualization]:enabled:(true false)' \
    'kernel[custom kernel binary (empty resets to default)]:kernel:_files'
}

