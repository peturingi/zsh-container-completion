__container_commands() {
  case $1 in
    (_container) reply=(
      'clean:clean one or more running containers'
      'copy:copy files/folders between a container and the local filesystem'
      'create:create a new container'
      'delete:delete one or more containers'
      'exec:run a new command in a running container'
      "export:export a container's filesystem as a tar archive"
      'inspect:display information about one or more containers'
      'kill:kill or signal one or more running containers'
      'list:list containers'
      'logs:fetch container logs'
      'run:run a container'
      'start:start a container'
      'stats:display resource usage statistics for containers'
      'stop:stop one or more running containers'
      'prune:remove all stopped containers'
      'build:build an image from a Dockerfile or Containerfile'
      'image:manage images'
      'registry:manage registry logins'
      'machine:manage container machines'
      'volume:manage container volumes'
      'builder:manage an image builder instance'
      'network:manage container networks'
      'system:manage system components'
      'help:show subcommand help information'
    ) ;;
    (_container_image) reply=(
      'delete:delete one or more images'
      'inspect:display information about one or more images'
      'list:list images'
      'load:load images from an OCI compatible tar archive'
      'prune:remove unused or all images'
      'pull:pull an image'
      'push:push an image'
      'save:save one or more images as an OCI compatible tar archive'
      'tag:create a new reference for an existing image'
    ) ;;
    (_container_registry) reply=(
      'login:log in to a registry'
      'logout:log out from a registry'
      'list:list image registry logins'
    ) ;;
    (_container_machine) reply=(
      'create:create a new container machine and boot it'
      'delete:delete a container machine'
      'inspect:display detailed information about a container machine'
      'list:list container machines'
      'logs:fetch container machine logs'
      'run:run a command or shell in a container machine, booting it if necessary'
      'set:set container machine configuration values'
      'set-default:set the default container machine'
      'stop:stop a running container machine'
    ) ;;
    (_container_volume) reply=(
      'create:create a new volume'
      'delete:delete one or more volumes'
      'list:list volumes'
      'inspect:display information about one or more volumes'
      'prune:remove volumes with no container references'
    ) ;;
    (_container_builder) reply=(
      'start:start the builder container'
      'status:display the builder container status'
      'stop:stop the builder container'
      'delete:delete the builder container'
    ) ;;
    (_container_network) reply=(
      'create:create a new network'
      'delete:delete one or more networks'
      'list:list networks'
      'inspect:display information about one or more networks'
      'prune:remove networks with no container connections'
    ) ;;
    (_container_system) reply=(
      'df:show disk usage for images, containers, and volumes'
      'dns:manage local DNS domains'
      'kernel:manage the default kernel configuration'
      'logs:fetch system logs for container services'
      'property:manage system property values'
      'start:start container services'
      'status:show the status of container services and system-wide information'
      'stop:stop all container services'
      'version:show version information'
    ) ;;
    (_container_system_dns) reply=(
      'create:create a local DNS domain for containers (requires admin)'
      'delete:delete a local DNS domain (requires admin)'
      'list:list local DNS domains'
    ) ;;
    (_container_system_kernel) reply=(
      'set:set the default kernel'
    ) ;;
    (_container_system_property) reply=(
      'list:list system properties'
    ) ;;
    (*) reply=() ;;
  esac
}

# Completes a command group: its subcommand names, then dispatches to
# <prefix>_<subcommand> for the subcommand's own arguments.
# usage: __container_group <prefix> <description>
(( $+functions[__container_group] )) ||
__container_group() {
  local prefix=$1 descr=$2 cmd
  local curcontext=$curcontext state state_descr line ret=1
  local -A opt_args
  local -a reply

  _arguments -C -s -S : $common \
    '(-): :->command' \
    '(-)*:: :->argument' && ret=0

  case $state in
    (command)
      __container_commands $prefix
      _describe -t commands "$descr command" reply && ret=0
      ;;
    (argument)
      cmd=${__container_aliases[$words[1]]:-$words[1]}
      curcontext=${curcontext%:*:*}:${${prefix#_}//_/-}-$cmd:
      if (( $+functions[${prefix}_$cmd] )); then
        _call_function ret ${prefix}_$cmd
      else
        _message "unknown $descr command: $words[1]"
      fi
      ;;
  esac
  return ret
}

# --- shared option sets ----------------------------------------------------

local -a common=(
  '--debug[enable debug output]'
  '(- *)--version[show the version]'
  '(- *)'{-h,--help}'[show help information]'
)

local -a formats=( '--format=[output format]:format:(json table yaml toml)' )

local -a process_opts=(
  '*'{-e,--env=}'[set environment variable (key=value, or key to inherit from host)]:environment variable:_parameters -g "*export*" -qS='
  '*--env-file=[read environment variables from a file]:env file:_files'
  '--gid=[group ID for the process]:gid: '
  '(-i --interactive)'{-i,--interactive}'[keep stdin open even if not attached]'
  '(-t --tty)'{-t,--tty}'[open a TTY with the process]'
  '(-u --user)'{-u,--user=}'[user for the process (name|uid\[\:gid\])]:user: '
  '--uid=[user ID for the process]:uid: '
  '(-w --workdir --cwd)'{-w,--workdir=,--cwd=}'[initial working directory inside the container]:directory in container: '
  '*--ulimit=[set resource limit (type=soft\[\:hard\])]:limit:__container_ulimit'
)

local -a dns_opts=(
  '*--dns=[DNS nameserver IP address]:IP address: '
  '--dns-domain=[default DNS domain]:domain: '
  '*--dns-option=[DNS option]:option: '
  '*--dns-search=[DNS search domain]:domain: '
)

local -a platform_opts=(
  '(-a --arch)'{-a,--arch=}'[architecture, if the image targets several]:architecture:(arm64 amd64)'
  '--os=[OS, if the image targets several]:os:(linux)'
  '--platform=[platform (os/arch\[/variant\]); overrides --os and --arch]:platform:(linux/arm64 linux/amd64)'
)

local -a scheme_opts=( '--scheme=[scheme for connecting to the registry]:scheme:(http https)' )
local -a progress_opts=( '--progress=[progress type]:type:(auto none ansi plain color)' )
local -a download_opts=( '--max-concurrent-downloads=[maximum number of concurrent downloads]:number: ' )

local capabilities='ALL CAP_AUDIT_CONTROL CAP_AUDIT_READ CAP_AUDIT_WRITE
  CAP_BLOCK_SUSPEND CAP_BPF CAP_CHECKPOINT_RESTORE CAP_CHOWN CAP_DAC_OVERRIDE
  CAP_DAC_READ_SEARCH CAP_FOWNER CAP_FSETID CAP_IPC_LOCK CAP_IPC_OWNER CAP_KILL
  CAP_LEASE CAP_LINUX_IMMUTABLE CAP_MAC_ADMIN CAP_MAC_OVERRIDE CAP_MKNOD
  CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_BROADCAST CAP_NET_RAW CAP_PERFMON
  CAP_SETFCAP CAP_SETGID CAP_SETPCAP CAP_SETUID CAP_SYS_ADMIN CAP_SYS_BOOT
  CAP_SYS_CHROOT CAP_SYS_MODULE CAP_SYS_NICE CAP_SYS_PACCT CAP_SYS_PTRACE
  CAP_SYS_RAWIO CAP_SYS_RESOURCE CAP_SYS_TIME CAP_SYS_TTY_CONFIG CAP_SYSLOG
  CAP_WAKE_ALARM'

local -a create_opts=(
  $process_opts $dns_opts $platform_opts $scheme_opts $download_opts
  '(-c --cpus)'{-c,--cpus=}'[number of CPUs to allocate]:cpus: '
  '(-m --memory)'{-m,--memory=}'[amount of memory, with optional K, M, G, T or P suffix]:memory: '
  "*--cap-add=[add a Linux capability]:capability:($capabilities)"
  "*--cap-drop=[drop a Linux capability]:capability:($capabilities)"
  '--cidfile=[write the container ID to a file]:cid file:_files'
  '(-d --detach)'{-d,--detach}'[run the container and detach from the process]'
  '--entrypoint=[override the entrypoint of the image]:entrypoint: '
  '--init[run an init process that forwards signals and reaps processes]'
  '--init-image=[custom init image]:image:__container_images'
  '(-k --kernel)'{-k,--kernel=}'[custom kernel path]:kernel:_files'
  '*--kernel-arg=[append a kernel boot argument]:argument: '
  '*'{-l,--label=}'[add a key=value label]:label: '
  '*--masked-path=[\[experimental\] hide a path inside the container (NONE clears)]:path in container: '
  '*--mount=[add a mount (type=,source=,target=,readonly)]:mount:__container_mount_spec'
  '--name=[use the given name as the container ID]:name: '
  '*--network=[attach to a network (name\[,mac=..\]\[,mtu=..\])]:network:__container_networks'
  '--no-dns[do not configure DNS in the container]'
  '*'{-p,--publish=}'[publish a port (\[host-ip\:\]host-port\:container-port\[/protocol\])]:port spec: '
  '*--publish-socket=[publish a socket (host_path\:container_path)]:socket spec:__container_socket_spec'
  "--read-only[mount the container's root filesystem read-only]"
  '*--read-only-path=[\[experimental\] mark a path inside the container read-only (NONE clears)]:path in container: '
  '(--rm --remove)'{--rm,--remove}'[remove the container after it stops]'
  '--rosetta[enable Rosetta in the container]'
  '--runtime=[runtime handler]:runtime:(container-runtime-linux)'
  '--ssh[forward the SSH agent socket to the container]'
  '--shm-size=[size of /dev/shm (e.g. 64M, 1G)]:size: '
  '*--tmpfs=[add a tmpfs mount at the given path]:path in container: '
  '--virtualization[expose virtualization capabilities to the container]'
  '*'{-v,--volume=}'[bind mount a volume (source\:target)]:volume:__container_volume_spec'
