(( $+functions[_container_help] )) ||
_container_help() {
  local prefix=_container cmd
  local -a reply
  local -i i
  # Walk the subcommands already given (after "help") to find the current group.
  for (( i = 2; i < CURRENT; i++ )); do
    cmd=${__container_aliases[$words[i]]:-$words[i]}
    __container_commands ${prefix}_$cmd
    (( $#reply )) || return 1
    prefix+=_$cmd
  done
  __container_commands $prefix
  _describe -t commands 'container command' reply
}

