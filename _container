# Arguments after the image (create/run) or container (exec) are passed to the
# process inside the container, so options stop being completed there.
local -a passthrough=( '*::command and arguments in container: ' )

local -A __container_aliases=(
  cp copy  rm delete  ls list
  i image  m machine  n network  r registry  s system  v volume
)

