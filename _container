# zsh completion for Apple's container CLI (https://github.com/apple/container).
# Written against release 1.5.0.
#
# Container IDs, images, networks, volumes, machines, DNS domains and registry
# logins are completed live from the container system service; when the service
# isn't running those simply complete nothing.

# --- dynamic values --------------------------------------------------------

# Containers, described by state and image. Arguments are compadd options
# (_arguments inserts its own right after an action's function name, before
# any arguments written in the spec), so the state filter comes from
# $_container_state, set by the wrappers below.
(( $+functions[__container_containers] )) ||
__container_containers() {
  local want=${_container_state:-all} line
  local -a rows fields ids

  rows=( ${(f)"$(_call_program containers $_container_bin list --all 2>/dev/null)"} )
  for line in ${rows[2,-1]}; do
    # ID IMAGE OS ARCH STATE ...; the first five columns are never empty
    fields=( ${=line} )
    case $want in
      (running) [[ $fields[5] == running ]] || continue ;;
      (stopped) [[ $fields[5] == running ]] && continue ;;
    esac
    ids+=( "${fields[1]//:/\\:}:$fields[5], $fields[2]" )
  done

  _describe -t containers "${${want:#all}:+$want }container" ids "$@"
}

(( $+functions[__container_running_containers] )) ||
__container_running_containers() {
  local _container_state=running
  __container_containers "$@"
}

(( $+functions[__container_stopped_containers] )) ||
__container_stopped_containers() {
  local _container_state=stopped
  __container_containers "$@"
}

# Names printed by `container <subcommand> list --quiet`.
# usage: __container_names <tag> <description> <subcommand> [compadd-options...]
(( $+functions[__container_names] )) ||
__container_names() {
  local tag=$1 descr=$2 sub=$3 expl
  shift 3
  local -a names
  names=( ${(f)"$(_call_program $tag $_container_bin ${=sub} list --quiet 2>/dev/null)"} )
  _wanted $tag expl $descr compadd "$@" -a names
}

(( $+functions[__container_images] )) ||
__container_images() { __container_names images image image "$@" }

(( $+functions[__container_networks] )) ||
__container_networks() { __container_names networks network network "$@" }

(( $+functions[__container_volumes] )) ||
